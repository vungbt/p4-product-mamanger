{
  "name": "p4-product-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @p4/api dev",
    "dev:web": "pnpm --filter @p4/web dev",
    "storybook": "pnpm --filter @p4/ui storybook",
    "build": "turbo build",
    "lint": "biome check apps libs",
    "format": "biome check --write apps libs",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:build": "docker build -t p4-api:latest -f apps/api/Dockerfile .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy:prod": "bash scripts/deploy.prod.sh",
    "db:tunnel": "bash scripts/db-tunnel.sh"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.9.0"
}
