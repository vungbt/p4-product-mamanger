{
  "name": "p4-product-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --filter=!./apps/stay/*",
    "dev:api": "pnpm --filter @p4/api dev",
    "dev:web": "pnpm --filter @p4/web dev",
    "dev:stay": "pnpm --filter @stay/api dev",
    "storybook": "pnpm --filter @p4/blocks storybook",
    "build": "turbo build",
    "lint": "biome check apps libs",
    "format": "biome check --write apps libs",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:build": "docker build -t p4-api:latest -f apps/api/Dockerfile .",
    "docker:build:stay": "docker build -t stay-api:latest -f apps/stay/api/Dockerfile .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy:prod": "bash scripts/deploy.prod.sh",
    "db:tunnel": "bash scripts/db-tunnel.sh",
    "build:storybook": "pnpm --filter @p4/blocks build-storybook",
    "deploy:web": "bash scripts/deploy.web.sh"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,html}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.9"
}
