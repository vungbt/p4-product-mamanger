# Copy → .env.prod (gitignored) rồi điền secret trước khi ./scripts/deploy.prod.sh

DATABASE_NAME=p4_product_manager
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me-strong-password

NODE_ENV=production
CORS_ORIGIN=https://your-app.vercel.app

JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOCALE_DEFAULT=vi

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=p4-product-manager
CLOUDINARY_DOMAIN=https://api.cloudinary.com/v1_1

PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=change-me-mock-pay-secret
DEFAULT_SHIPPING_FEE=30000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=vnd
CHECKOUT_SUCCESS_URL=https://your-app.vercel.app/shop/orders/{ORDER_ID}?paid=1
CHECKOUT_CANCEL_URL=https://your-app.vercel.app/shop/cart?cancelled=1

RUN_SEED=true
