# Copy → .env.prod (gitignored) rồi điền secret trước khi ./scripts/deploy.prod.sh

DATABASE_NAME=p4_product_manager
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me-strong-password

NODE_ENV=production
# Also lists the local Vite origin so web developers can sign in against this API.
CORS_ORIGIN=https://p4.couponlinkh.com,https://p4-api.couponlinkh.com,http://localhost:5173

JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOCALE_DEFAULT=vi

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=p4-product-manager
CLOUDINARY_DOMAIN=https://api.cloudinary.com/v1_1

PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=change-me-mock-pay-secret
DEFAULT_SHIPPING_FEE=30000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=vnd
CHECKOUT_SUCCESS_URL=https://p4.couponlinkh.com/shop/orders/{ORDER_ID}?paid=1
CHECKOUT_CANCEL_URL=https://p4.couponlinkh.com/shop/cart?cancelled=1

# Google OAuth (cùng Client ID với web env VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=640928054192-9i16jb4976go1e8n2tq2n1ba9k44me2d.apps.googleusercontent.com

RUN_SEED=true

# Scalar: blank uses the current host; set the public origin behind a gateway.
PUBLIC_API_URL=https://p4-api.couponlinkh.com
# Encrypt queued account mail; use a separate random key (at least 32 characters).
MAIL_ENCRYPTION_KEY=replace-with-separate-random-key-at-least-32-characters
MAIL_API_URL=
MAIL_API_TOKEN=
# Compose API + worker share a private volume at /app/process-storage.

# Better Auth (public API origin, not the frontend origin).
BETTER_AUTH_URL=https://p4-api.couponlinkh.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_SECRET=
