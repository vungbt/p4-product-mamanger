# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=p4_product_manager
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# API
PORT=3001
NODE_ENV=development
# Comma-separated origins, or * for all
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=p4-dev-secret-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOCALE_DEFAULT=vi

# Cloudinary (https://cloudinary.com — free tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=p4-product-manager
# Optional — default https://api.cloudinary.com/v1_1
CLOUDINARY_DOMAIN=https://api.cloudinary.com/v1_1

# Checkout / payments
# mock | stripe
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=p4-mock-pay-secret
DEFAULT_SHIPPING_FEE=30000

# Google OAuth (storefront — GIS ID token; chỉ cần Client ID, không cần Client secret)
# OAuth Web client → Authorized JS origins: http://localhost:5173
# Consent screen (Testing) → thêm Test users
GOOGLE_CLIENT_ID=640928054192-9i16jb4976go1e8n2tq2n1ba9k44me2d.apps.googleusercontent.com

# Stripe (khi PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# vnd = zero-decimal (số nguyên VND). Account không hỗ trợ thì dùng usd (amount vẫn là integer minor units — cần đổi quy đổi nếu dùng usd)
STRIPE_CURRENCY=vnd
CHECKOUT_SUCCESS_URL=http://localhost:5173/shop/orders/{ORDER_ID}?paid=1
CHECKOUT_CANCEL_URL=http://localhost:5173/shop/cart?cancelled=1

# Set true on first deploy / local seed
RUN_SEED=true

# Better Auth (public API origin, not the frontend origin).
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_SECRET=

# Stay (apps/stay/api, pnpm dev:stay) — own database in the same Postgres server.
# docker-compose.dev.yml creates STAY_DATABASE_NAME when it is missing.
STAY_PORT=3011
STAY_DATABASE_HOST=localhost
STAY_DATABASE_PORT=5432
STAY_DATABASE_NAME=p4_stay
STAY_DATABASE_USERNAME=postgres
STAY_DATABASE_PASSWORD=postgres
# Public API origin (not the web origin); HTTPS in production.
STAY_BETTER_AUTH_URL=http://127.0.0.1:3011
STAY_BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated @stay/web origins; localhost:5174 is trusted outside production.
STAY_CORS_ORIGIN=http://localhost:5174
# Optional public @stay/web origin for invoice share links (/i/:token); default: the caller's
# allowed web origin, else the first STAY_CORS_ORIGIN.
STAY_WEB_URL=
# Optional Google sign-in (existing tenant accounts only; owners/managers use a password).
STAY_GOOGLE_CLIENT_ID=
STAY_GOOGLE_CLIENT_SECRET=
# Optional server URL shown in /api/docs.
STAY_PUBLIC_API_URL=
# Private images (CCCD). Empty: a local stub storage outside production; production refuses uploads.
STAY_CLOUDINARY_CLOUD_NAME=
STAY_CLOUDINARY_API_KEY=
STAY_CLOUDINARY_API_SECRET=
STAY_CLOUDINARY_FOLDER=stay
# Notification email (worker). Empty host: email disabled. Local Mailpit: localhost / 1025.
STAY_SMTP_HOST=
STAY_SMTP_PORT=1025
STAY_SMTP_SECURE=false
STAY_SMTP_USER=
STAY_SMTP_PASSWORD=
STAY_MAIL_FROM=no-reply@stay.local
# Browser notifications (Web Push). Empty keys: disabled. Generate a pair with
# `pnpm --filter @stay/api exec web-push generate-vapid-keys`; never commit the private key.
STAY_VAPID_PUBLIC_KEY=
STAY_VAPID_PRIVATE_KEY=
STAY_VAPID_SUBJECT=mailto:no-reply@stay.local
