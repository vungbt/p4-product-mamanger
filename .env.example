# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=p4_product_manager
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# API
PORT=3001
NODE_ENV=development
# Comma-separated origins, or * for all
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=p4-dev-secret-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOCALE_DEFAULT=vi

# Cloudinary (https://cloudinary.com — free tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=p4-product-manager
# Optional — default https://api.cloudinary.com/v1_1
CLOUDINARY_DOMAIN=https://api.cloudinary.com/v1_1

# Checkout / payments
# mock | stripe
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=p4-mock-pay-secret
DEFAULT_SHIPPING_FEE=30000

# Stripe (khi PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# vnd = zero-decimal (số nguyên VND). Account không hỗ trợ thì dùng usd (amount vẫn là integer minor units — cần đổi quy đổi nếu dùng usd)
STRIPE_CURRENCY=vnd
CHECKOUT_SUCCESS_URL=http://localhost:5173/shop/orders/{ORDER_ID}?paid=1
CHECKOUT_CANCEL_URL=http://localhost:5173/shop/cart?cancelled=1

# Set true on first deploy / local seed
RUN_SEED=true
