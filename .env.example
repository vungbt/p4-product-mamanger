# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=p4_product_manager
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# API
PORT=3001
NODE_ENV=development
# Comma-separated origins, or * for all
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=p4-dev-secret-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOCALE_DEFAULT=vi

# Cloudinary (https://cloudinary.com — free tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=p4-product-manager
# Optional — default https://api.cloudinary.com/v1_1
CLOUDINARY_DOMAIN=https://api.cloudinary.com/v1_1

# Set true on first deploy / local seed
RUN_SEED=true
