# Stay production — copy to the server as /root/apps/stay/.env.stay.prod (chmod 600).
# Values must not contain spaces (the backup script sources this file).
# Generate secrets with: openssl rand -base64 48 | tr -d '\n/+='

STAY_DATABASE_NAME=p4_stay
STAY_DATABASE_USERNAME=stay
STAY_DATABASE_PASSWORD=change-me-strong-password

STAY_BETTER_AUTH_URL=https://stay.itclabs.site
STAY_BETTER_AUTH_SECRET=change-me-at-least-32-random-characters
STAY_CORS_ORIGIN=https://stay.itclabs.site
STAY_WEB_URL=https://stay.itclabs.site
STAY_PUBLIC_API_URL=https://stay-api.itclabs.site

# Private uploads (CCCD, receipts): shared Cloudinary account, separate folder.
STAY_CLOUDINARY_CLOUD_NAME=
STAY_CLOUDINARY_API_KEY=
STAY_CLOUDINARY_API_SECRET=
STAY_CLOUDINARY_FOLDER=stay

# Email (empty host disables email; in-app and browser notifications still work).
STAY_SMTP_HOST=
STAY_SMTP_PORT=587
STAY_SMTP_SECURE=false
STAY_SMTP_USER=
STAY_SMTP_PASSWORD=
STAY_MAIL_FROM=no-reply@itclabs.site

# Browser push: pnpm --filter @stay/api exec web-push generate-vapid-keys
STAY_VAPID_PUBLIC_KEY=
STAY_VAPID_PRIVATE_KEY=
STAY_VAPID_SUBJECT=mailto:no-reply@itclabs.site

# Optional Google sign-in for tenants.
STAY_GOOGLE_CLIENT_ID=
STAY_GOOGLE_CLIENT_SECRET=
