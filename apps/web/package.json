{
  "name": "@p4/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "pnpm -w exec biome check apps/web/src",
    "preview": "vite preview",
    "prebuild": "pnpm --filter @p4/ability build && pnpm --filter @p4/api-sdk build",
    "predev": "pnpm --filter @p4/ability build && pnpm --filter @p4/api-sdk build",
    "test": "node --import ./tests/register-aliases.mjs --test src/libraries/collection-editor/*.test.mjs src/modules/admin/products/hooks/*.test.mjs src/libraries/forms/*.test.mjs tests/*.test.ts"
  },
  "dependencies": {
    "@itclabs/react-ui": "0.32.0",
    "@p4/ability": "workspace:*",
    "@p4/api-client": "workspace:*",
    "@p4/api-sdk": "workspace:*",
    "@p4/auth": "workspace:*",
    "@p4/blocks": "workspace:*",
    "@p4/i18n": "workspace:*",
    "@p4/shared": "workspace:*",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-is": "19.2.0",
    "react-router-dom": "catalog:",
    "recharts": "3.10.1",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "sass": "catalog:",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
