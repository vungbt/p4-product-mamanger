{
  "name": "@stay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json && cp -R src/language dist/language",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "pnpm -w exec biome check apps/stay/api",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "openapi:generate": "pnpm build && node ../../api/scripts/openapi/generate.mjs --config scripts/openapi/config.mjs",
    "openapi:check": "pnpm build && node ../../api/scripts/openapi/generate.mjs --config scripts/openapi/config.mjs --check",
    "test": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs",
    "prebuild": "pnpm --filter @p4/ability build && pnpm --filter @p4/server-core build && pnpm --filter @stay/billing build",
    "predev": "pnpm --filter @p4/ability build && pnpm --filter @p4/server-core build && pnpm --filter @stay/billing build"
  },
  "dependencies": {
    "@p4/ability": "workspace:*",
    "@p4/server-core": "workspace:*",
    "@p4/shared": "workspace:*",
    "@scalar/express-api-reference": "catalog:",
    "@stay/billing": "workspace:*",
    "@stay/shared": "workspace:*",
    "bcryptjs": "catalog:",
    "better-auth": "catalog:",
    "cls-hooked": "catalog:",
    "compression": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "i18next": "catalog:",
    "i18next-fs-backend": "catalog:",
    "i18next-http-middleware": "catalog:",
    "pg": "catalog:",
    "pg-hstore": "catalog:",
    "sequelize": "catalog:",
    "sequelize-cli": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/cls-hooked": "catalog:",
    "@types/compression": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
