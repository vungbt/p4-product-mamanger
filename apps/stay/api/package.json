{
  "name": "@stay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json && rm -rf dist/language dist/assets && cp -R src/language dist/language && cp -R src/assets dist/assets",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "lint": "pnpm -w exec biome check apps/stay/api",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "openapi:generate": "pnpm build && node scripts/openapi/generate-offline.mjs",
    "openapi:check": "pnpm build && node scripts/openapi/generate-offline.mjs --check",
    "test": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs",
    "prebuild": "pnpm --filter @p4/ability build && pnpm --filter @p4/server-core build && pnpm --filter @stay/billing build",
    "predev": "pnpm --filter @p4/ability build && pnpm --filter @p4/server-core build && pnpm --filter @stay/billing build",
    "openapi:generate:offline": "pnpm build && node scripts/openapi/generate-offline.mjs"
  },
  "dependencies": {
    "@p4/ability": "workspace:*",
    "@p4/server-core": "workspace:*",
    "@p4/shared": "workspace:*",
    "@scalar/express-api-reference": "catalog:",
    "@stay/billing": "workspace:*",
    "@stay/shared": "workspace:*",
    "bcryptjs": "catalog:",
    "better-auth": "catalog:",
    "cloudinary": "catalog:",
    "cls-hooked": "catalog:",
    "compression": "catalog:",
    "cors": "catalog:",
    "csv-parse": "catalog:",
    "dotenv": "catalog:",
    "exceljs": "4.4.0",
    "express": "catalog:",
    "helmet": "catalog:",
    "htmlparser2": "12.0.0",
    "i18next": "catalog:",
    "i18next-fs-backend": "catalog:",
    "i18next-http-middleware": "catalog:",
    "mammoth": "1.13.0",
    "multer": "catalog:",
    "pdfmake": "0.3.12",
    "pg": "catalog:",
    "pg-hstore": "catalog:",
    "sanitize-html": "2.18.1",
    "sequelize": "catalog:",
    "sequelize-cli": "catalog:",
    "unzipper": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/cls-hooked": "catalog:",
    "@types/compression": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "catalog:",
    "@types/sanitize-html": "2.16.2",
    "@types/unzipper": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
